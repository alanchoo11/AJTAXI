# Public values used by the browser for Supabase Auth (anon/publishable key only).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_WHATSAPP_NUMBER=replace-with-confirmed-number
VITE_SITE_URL=https://example.com

# Server-only Netlify Function variables. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
RATE_LIMIT_SECRET=replace-with-a-long-random-server-only-secret
WHATSAPP_NUMBER=replace-with-confirmed-number
